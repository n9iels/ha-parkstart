script:post-response {
  const data = (res.getBody() || {}).data || [];
  if (data.length) bru.setVar("parkingSessionId", data[0].id);
}

tests {
  test("has data array", function () {
    expect(res.getBody().data).to.be.an("array");
  });
}

docs {
  Active + planned sessions. timeStartUtc/timeEndUtc are Europe/Amsterdam LOCAL time despite the name.
  Sets runtime var parkingSessionId to the first session.
}
