{
  "info": {
    "name": "ParkStart Gouda (parkpermit.eu)",
    "description": "Unofficial headless API for https://parkstart-gouda.parkpermit.eu (ARS T&TT ParkStart). Run Auth 1→2 first; Postman's cookie jar keeps the session. See docs/API.md for details.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Get login page (CSRF token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Loads the login form. Sets the `__RequestVerificationToken` cookie and extracts the hidden form token into `csrfToken`.\n\nNOTE: if you are still logged in (Postman keeps cookies between runs), the server logs you out first: `302 → /` with the auth cookie cleared, then the login form. Redirects must be followed for this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const input = (html.match(/<input[^>]*name=\"__RequestVerificationToken\"[^>]*>/) || [])[0];",
                  "const m = input && input.match(/value=\"([^\"]+)\"/);",
                  "if (!m) {",
                  "  console.log('No CSRF token. Status:', pm.response.code, pm.response.status);",
                  "  console.log('Headers:', pm.response.headers.toObject());",
                  "  console.log('Body (first 1500 chars):', html.substring(0, 1500));",
                  "  if (/g-recaptcha/.test(html) && /ShowCaptcha\" type=\"hidden\" value=\"True\"/.test(html))",
                  "    console.log('Captcha is enabled (too many failed logins). Log in once in a browser, then retry.');",
                  "  if (pm.response.code === 302)",
                  "    console.log('Got a redirect: enable \"Automatically follow redirects\" (Settings) or clear cookies for this domain.');",
                  "}",
                  "pm.test('csrf token found', () => pm.expect(m, 'see Postman console for the response').to.be.ok);",
                  "if (m) pm.collectionVariables.set('csrfToken', m[1]);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": true,
            "maxRedirects": 5
          },
          "response": [
            {
              "name": "200 login form (excerpt)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "html",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/html; charset=utf-8"
                },
                {
                  "key": "Set-Cookie",
                  "value": "__RequestVerificationToken=<redacted>; path=/; secure; HttpOnly; SameSite=Strict"
                }
              ],
              "body": "<form action=\"/\" aria-label=\"Inloggen\" method=\"post\"><input name=\"__RequestVerificationToken\" type=\"hidden\" value=\"<redacted>\" />\n  ... <input id=\"ShowCaptcha\" name=\"ShowCaptcha\" type=\"hidden\" value=\"False\" /> ...\n</form>",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": []
                },
                "description": "Loads the login form. Sets the `__RequestVerificationToken` cookie and extracts the hidden form token into `csrfToken`.\n\nNOTE: if you are still logged in (Postman keeps cookies between runs), the server logs you out first: `302 → /` with the auth cookie cleared, then the login form. Redirects must be followed for this request."
              }
            }
          ]
        },
        {
          "name": "2. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "Form login. Success = **302 to /Customer/PlanSession** + `.AspNet._SSPAuthCookie` cookie. A failed login returns 200 with the form again. Repeated failures enable reCAPTCHA, so do NOT retry in a loop.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "__RequestVerificationToken",
                  "value": "{{csrfToken}}"
                },
                {
                  "key": "Email",
                  "value": "{{email}}"
                },
                {
                  "key": "Password",
                  "value": "{{password}}"
                },
                {
                  "key": "ReturnUrl",
                  "value": ""
                },
                {
                  "key": "ShowCaptcha",
                  "value": "False"
                },
                {
                  "key": "ScreenWidth",
                  "value": "1440"
                },
                {
                  "key": "ScreenHeight",
                  "value": "900"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('302 to PlanSession', () => {",
                  "  pm.response.to.have.status(302);",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/Customer/PlanSession');",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "response": [
            {
              "name": "302 success",
              "status": "Found",
              "code": 302,
              "_postman_previewlanguage": "html",
              "header": [
                {
                  "key": "Location",
                  "value": "/Customer/PlanSession"
                },
                {
                  "key": "Set-Cookie",
                  "value": ".AspNet._SSPAuthCookie=<redacted>; path=/; secure; HttpOnly; SameSite=Lax"
                }
              ],
              "body": "<html><head><title>Object moved</title></head><body>\n<h2>Object moved to <a href=\"/Customer/PlanSession\">here</a>.</h2>\n</body></html>",
              "originalRequest": {
