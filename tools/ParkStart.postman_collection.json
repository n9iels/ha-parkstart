        {
          "name": "3. Plan session page (permits + addItem template)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Customer/PlanSession",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "PlanSession"
              ]
            },
            "description": "HTML page. The view model is embedded as JSON in `planSession.init('...')`. Contains `permitList` (id, permitProduct, paidParkingAreaIdDescription, unlimitedTimeBalance, ...) and the `addItem` template used as the StartParkingSession body. Sets `permitId` and `addItemTemplate`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const m = pm.response.text().match(/planSession\\.init\\('([\\s\\S]*?)'\\);/);",
                  "pm.test('view model found (logged in)', () => pm.expect(m).to.not.be.null);",
                  "const model = JSON.parse(m[1].replace(/\\\\\"/g, '\"').replace(/\\\\\\\\/g, '\\\\'));",
                  "console.log('permits', model.permitList);",
                  "pm.collectionVariables.set('permitId', model.permitList[0].id);",
                  "pm.collectionVariables.set('addItemTemplate', JSON.stringify(model.addItem));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 page (excerpt with permitList)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "html",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/html; charset=utf-8"
                }
              ],
              "body": "<!-- excerpt: the full page is ~35kB of HTML; the data lives in this inline script -->\n<script>\n  require(['views/customer/planSession/planSession'], function (planSession) {\nplanSession.init('{\\\"permitList\\\": [{\\\"id\\\": 10001, \\\"customerId\\\": 30001, \\\"permitMediaCode\\\": null, \\\"cli\\\": null, \\\"paidParkingAreaId\\\": \\\"BEZ_S-1\\\", \\\"status\\\": \\\"Active\\\", \\\"statusId\\\": 41, \\\"permitAreaDescription\\\": null, \\\"canStopActive\\\": false, \\\"timeBalance\\\": 10000, \\\"permitProduct\\\": \\\"Bezoeker bewoner\\\", \\\"ppCode\\\": \\\"RGBZ\\\", \\\"ppTranslation\\\": null, \\\"permitProductId\\\": 0, \\\"pin\\\": null, \\\"sospesPermitPermitId\\\": \\\"1000000001\\\", \\\"permitAreaId\\\": \\\"BEZ_S-1\\\", \\\"nprAreaManagerId\\\": null, \\\"paidParkingAreaIdDescription\\\": \\\"Sector 1 (Example)\\\", \\\"permitAreaIdDescription\\\": null, \\\"validFromDateUtc\\\": \\\"2025-01-01T23:00:00\\\", \\\"validUntilDateUtc\\\": \\\"2075-01-01T23:00:00\\\", \\\"unlimitedTimeBalance\\\": true, \\\"isDeleted\\\": false, \\\"permitProductAndSospesNumber\\\": \\\"Bezoeker bewoner / 1000000001 - Gebruik\\\", \\\"isSynced\\\": null, \\\"backOfficeCanAddEditPermit\\\": false, \\\"backOfficeCanTerminate\\\": false, \\\"numOfSessions\\\": null, \\\"allowDynamicNumOfSessions\\\": false, \\\"isBusinessPermit\\\": false, \\\"displayExpression\\\": \\\"Bezoeker bewoner - Sector 1 (Example) / 1000000001 - Gebruik\\\", \\\"authSuffix\\\": \\\" - Gebruik\\\", \\\"totalParkingRights\\\": 0, \\\"isGaragePermit\\\": false}], \\\"addItem\\\": \\\"{ ...addItem template, see StartParkingSession body... }\\\", \\\"licensePlates\\\": [], \\\"customerId\\\": 0, \\\"area\\\": \\\"Customer\\\", \\\"fillEndTime\\\": true, \\\"validateLpOnRdw\\\": true}');\n  });\n</script>",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
