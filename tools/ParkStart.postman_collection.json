      "item": [
        {
          "name": "6. Start parking session  ⚠ costs money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/Customer/PlanSession"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Customer/PlanSession/StartParkingSession",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Customer",
                "PlanSession",
                "StartParkingSession"
              ]
            },
            "description": "Registers a visitor session. Body = the `addItem` template from request 3 with permitId, lp, timeStart, timeEnd (ISO UTC with Z) filled in. The pre-request script builds it from `licensePlate` and `durationMinutes`. Response: `{\"successful\":true}`; on failure `successful:false` + `notifications`.",
            "body": {
              "mode": "raw",
              "raw": "{{startBody}}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tpl = JSON.parse(pm.collectionVariables.get('addItemTemplate') || '{}');",
                  "const permitId = Number(pm.collectionVariables.get('permitId'));",
                  "const start = new Date(); start.setSeconds(0, 0);",
                  "const end = new Date(start.getTime() + Number(pm.collectionVariables.get('durationMinutes')) * 60000);",
                  "Object.assign(tpl, {",
                  "  permitId, currentPermitId: permitId,",
                  "  lp: pm.collectionVariables.get('licensePlate'),",
                  "  timeStart: start.toISOString(), timeEnd: end.toISOString(),",
                  "  saveMode: true",
                  "});",
                  "pm.collectionVariables.set('startBody', JSON.stringify(tpl));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('successful', () => pm.expect(pm.response.json().successful).to.eql(true));"
                ]
              }
            }
          ],
          "response": [
